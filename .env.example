# Personal Life OS — Environment Configuration Example
# Copy this file to .env and adjust values as needed. Never commit real secrets to version control.

# Backend Server Configuration
APP_NAME="Personal Life OS"
APP_ENV="development"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000

# Security & Session Signing (Replace with a random 32+ byte hex string in your local .env)
SECRET_KEY="replace-with-secure-random-hex-secret-key-generated-on-setup"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Local SQLite Database Path (Relative to project root or absolute path)
DATABASE_URL="sqlite:///./data/personal_life_os.db"
# Optional future PostgreSQL support:
# DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/personal_life_os"

# Default Regional & Currency Preferences
DEFAULT_CURRENCY="INR"
DEFAULT_TIMEZONE="Asia/Kolkata"

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000/api/v1"
FRONTEND_PORT=3000

# Optional External Integrations (Disabled by default for strict local-first privacy)
ENABLE_EXTERNAL_INTEGRATIONS="false"

